+/// A single query-string parameter from the page URL, URL-decoded (`?key=value`, first match).
+fn query_param(key: &str) -> Option<String> {
+    let q = query();
+    let q = q.strip_prefix('?').unwrap_or(q.as_str());
+    for pair in q.split('&') {
+        let mut it = pair.splitn(2, '=');
+        if it.next() == Some(key) {
+            let raw = it.next().unwrap_or("");
+            let decoded =
+                js_sys::decode_uri_component(raw).ok().and_then(|v| v.as_string()).unwrap_or_else(|| raw.to_string());
+            return Some(decoded);
+        }
+    }
+    None
+}
+
+/// Fetch bytes over the network (same-origin cookies included) for `?src=`.
+async fn fetch_bytes(url: &str) -> Result<Vec<u8>, String> {
+    let js = |e: wasm_bindgen::JsValue| format!("{e:?}");
+    let window = web_sys::window().ok_or("no window")?;
+    let resp_val = wasm_bindgen_futures::JsFuture::from(window.fetch_with_str(url)).await.map_err(js)?;
+    let resp: web_sys::Response = resp_val.dyn_into().map_err(|_| "not a Response".to_string())?;
+    if !resp.ok() {
+        return Err(format!("HTTP {}", resp.status()));
+    }
+    let buf = wasm_bindgen_futures::JsFuture::from(resp.array_buffer().map_err(js)?).await.map_err(js)?;
+    Ok(js_sys::Uint8Array::new(&buf).to_vec())
+}
+
+/// Write the primary save (same filename as the opened file) back to Nextcloud over WebDAV.
+fn save_back(save_url: &Option<String>, src_name: &Option<String>, name: &str, bytes: &[u8]) -> bool {
+    let base = std::path::Path::new(name).file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_default();
+    if let (Some(url), Some(sn)) = (save_url, src_name)
+        && &base == sn
+    {
+        put_back(url, bytes);
+        return true;
+    }
+    false
+}
+
+fn put_back(url: &str, bytes: &[u8]) {
+    let url = url.to_string();
+    let body = js_sys::Uint8Array::from(bytes);
+    wasm_bindgen_futures::spawn_local(async move {
+        let Some(window) = web_sys::window() else { return };
+        let init = web_sys::RequestInit::new();
+        init.set_method("PUT");
+        init.set_body(body.as_ref());
+        init.set_credentials(web_sys::RequestCredentials::Include);
+        if let Some(token) = fetch_csrf_token(&window).await
+            && let Ok(h) = web_sys::Headers::new()
+        {
+            let _ = h.set("requesttoken", &token);
+            init.set_headers(h.as_ref());
+        }
+        let req = match web_sys::Request::new_with_str_and_init(&url, &init) {
+            Ok(r) => r,
+            Err(e) => {
+                log::error!("save request build failed: {e:?}");
+                return;
+            }
+        };
+        match wasm_bindgen_futures::JsFuture::from(window.fetch_with_request(&req)).await {
+            Ok(resp_val) => match resp_val.dyn_into::<web_sys::Response>() {
+                Ok(resp) if resp.ok() => log::info!("saved back to Nextcloud (HTTP {})", resp.status()),
+                Ok(resp) => log::error!("save PUT rejected: HTTP {}", resp.status()),
+                Err(_) => log::error!("save PUT: not a Response"),
+            },
+            Err(e) => log::error!("save PUT failed: {e:?}"),
+        }
+    });
+}
+
+async fn fetch_csrf_token(window: &web_sys::Window) -> Option<String> {
+    let init = web_sys::RequestInit::new();
+    init.set_credentials(web_sys::RequestCredentials::Include);
+    let req = web_sys::Request::new_with_str_and_init("/index.php/csrftoken", &init).ok()?;
+    let resp_val = wasm_bindgen_futures::JsFuture::from(window.fetch_with_request(&req)).await.ok()?;
+    let resp: web_sys::Response = resp_val.dyn_into().ok()?;
+    if !resp.ok() {
+        return None;
+    }
+    let text_val = wasm_bindgen_futures::JsFuture::from(resp.text().ok()?).await.ok()?;
+    let parsed = js_sys::JSON::parse(&text_val.as_string()?).ok()?;
+    js_sys::Reflect::get(&parsed, &wasm_bindgen::JsValue::from_str("token")).ok()?.as_string()
+}
